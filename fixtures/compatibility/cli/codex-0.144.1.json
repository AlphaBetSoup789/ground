{
  "schemaVersion": 1,
  "suite": {
    "id": "codex-cli-0.144.1",
    "kind": "cli",
    "adapter": "codex",
    "runtime": "Codex CLI",
    "version": "0.144.1",
    "fixtureDate": "2026-07-29",
    "provenance": "synthetic-contract",
    "provenanceNote": "Hand-authored from Ground's reviewed parser contract for the locally observed help and tagged 0.144.1 source surfaces; not captured from a live or authenticated Codex run.",
    "liveCapture": false
  },
  "cases": [
    {
      "id": "session-and-assistant",
      "description": "Normalize a native thread identifier and a final assistant message.",
      "inputEvents": [
        {
          "type": "thread.started",
          "thread_id": "codex-thread-1"
        },
        {
          "type": "item.completed",
          "item": {
            "id": "message-1",
            "type": "agent_message",
            "text": "Done"
          }
        }
      ],
      "expectedCanonicalEvents": [
        {
          "type": "session",
          "sessionId": "codex-thread-1"
        },
        {
          "type": "text",
          "delta": "Done",
          "final": true
        }
      ]
    },
    {
      "id": "command-and-usage",
      "description": "Normalize command progress, completion, and cumulative turn usage.",
      "inputEvents": [
        {
          "type": "item.updated",
          "item": {
            "id": "command-1",
            "type": "command_execution",
            "command": "npm test",
            "aggregated_output": "running",
            "exit_code": null,
            "status": "in_progress"
          }
        },
        {
          "type": "item.completed",
          "item": {
            "id": "command-1",
            "type": "command_execution",
            "command": "npm test",
            "aggregated_output": "passed",
            "exit_code": 0,
            "status": "completed"
          }
        },
        {
          "type": "turn.completed",
          "usage": {
            "input_tokens": 120,
            "cached_input_tokens": 90,
            "output_tokens": 12
          }
        }
      ],
      "expectedCanonicalEvents": [
        {
          "type": "activity",
          "activity": {
            "runtimeId": "codex:command-1",
            "activityType": "command",
            "title": "npm test",
            "detail": "\"running\"",
            "status": "running"
          }
        },
        {
          "type": "activity",
          "activity": {
            "runtimeId": "codex:command-1",
            "activityType": "command",
            "title": "npm test",
            "detail": "\"passed\"",
            "status": "success"
          }
        },
        {
          "type": "activity",
          "activity": {
            "runtimeId": "codex:turn",
            "activityType": "status",
            "title": "Codex turn",
            "status": "success"
          }
        },
        {
          "type": "usage",
          "usage": {
            "inputTokens": 120,
            "outputTokens": 12,
            "cachedInputTokens": 90
          }
        }
      ]
    },
    {
      "id": "declined-command-and-nonfatal-notice",
      "description": "Treat declined commands as failed activities and Codex non-fatal error items as warning diagnostics.",
      "inputEvents": [
        {
          "type": "item.completed",
          "item": {
            "id": "command-2",
            "type": "command_execution",
            "command": "git push",
            "aggregated_output": "",
            "exit_code": null,
            "status": "declined"
          }
        },
        {
          "type": "item.completed",
          "item": {
            "id": "warning-1",
            "type": "error",
            "message": "An optional MCP server did not start"
          }
        }
      ],
      "expectedCanonicalEvents": [
        {
          "type": "activity",
          "activity": {
            "runtimeId": "codex:command-2",
            "activityType": "command",
            "title": "git push",
            "detail": "\"\"",
            "status": "error"
          }
        },
        {
          "type": "diagnostic",
          "detail": "An optional MCP server did not start"
        }
      ]
    }
  ]
}
