{
  "schemaVersion": 1,
  "suite": {
    "id": "gemini-cli-0.47.0",
    "kind": "cli",
    "adapter": "gemini",
    "runtime": "Gemini CLI",
    "version": "0.47.0",
    "fixtureDate": "2026-07-29",
    "provenance": "synthetic-contract",
    "provenanceNote": "Hand-authored from Ground's reviewed parser contract for the locally observed help, bundled documentation, and tagged 0.47.0 source surfaces; not captured from a live or authenticated Gemini CLI run.",
    "liveCapture": false
  },
  "cases": [
    {
      "id": "session-text-and-tool",
      "description": "Normalize initialization, streamed assistant text, and a shell tool lifecycle.",
      "inputEvents": [
        {
          "type": "init",
          "session_id": "gemini-session-1",
          "model": "gemini-fixture"
        },
        {
          "type": "message",
          "role": "assistant",
          "content": "hello",
          "delta": true
        },
        {
          "type": "tool_use",
          "tool_id": "shell-1",
          "tool_name": "run_shell_command",
          "parameters": {
            "command": "npm test"
          }
        },
        {
          "type": "tool_result",
          "tool_id": "shell-1",
          "status": "success",
          "output": "passed"
        }
      ],
      "expectedCanonicalEvents": [
        {
          "type": "session",
          "sessionId": "gemini-session-1"
        },
        {
          "type": "activity",
          "activity": {
            "activityType": "status",
            "title": "Gemini session ready",
            "detail": "Model: gemini-fixture",
            "status": "success"
          }
        },
        {
          "type": "text",
          "delta": "hello",
          "final": false
        },
        {
          "type": "activity",
          "activity": {
            "runtimeId": "gemini:shell-1",
            "activityType": "command",
            "title": "run_shell_command",
            "detail": "{\"command\":\"npm test\"}",
            "status": "running"
          }
        },
        {
          "type": "activity",
          "activity": {
            "runtimeId": "gemini:shell-1",
            "activityType": "tool",
            "title": "Gemini tool result",
            "detail": "\"passed\"",
            "status": "success"
          }
        }
      ]
    },
    {
      "id": "usage",
      "description": "Normalize Gemini result statistics.",
      "inputEvents": [
        {
          "type": "result",
          "status": "success",
          "stats": {
            "input_tokens": 10,
            "output_tokens": 4,
            "cached": 3,
            "total_tokens": 14
          }
        }
      ],
      "expectedCanonicalEvents": [
        {
          "type": "usage",
          "usage": {
            "inputTokens": 10,
            "outputTokens": 4,
            "cachedInputTokens": 3,
            "totalTokens": 14
          }
        }
      ]
    },
    {
      "id": "warning-and-error-severity",
      "description": "Keep non-fatal warnings diagnostic while surfacing error-severity events as failed activities.",
      "inputEvents": [
        {
          "type": "error",
          "severity": "warning",
          "message": "Loop detected, stopping execution"
        },
        {
          "type": "error",
          "severity": "error",
          "message": "Maximum session turns exceeded"
        }
      ],
      "expectedCanonicalEvents": [
        {
          "type": "diagnostic",
          "detail": "Loop detected, stopping execution"
        },
        {
          "type": "activity",
          "activity": {
            "activityType": "error",
            "title": "Gemini reported an error",
            "detail": "Maximum session turns exceeded",
            "status": "error"
          }
        }
      ]
    }
  ]
}
